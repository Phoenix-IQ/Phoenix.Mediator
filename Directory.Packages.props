<Project>

  <!-- Every package version in the repository, in one place (NuGet Central Package Management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phoenix.Mediator.Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Phoenix.Mediator.Sentry and Phoenix.Mediator.Serilog.Sentry. Keep all three on one version:
         Sentry.AspNetCore and Sentry.Serilog each depend on the Sentry package of their own version. -->
    <PackageVersion Include="Sentry" Version="6.5.0" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.5.0" />
    <PackageVersion Include="Sentry.Serilog" Version="6.5.0" />

    <!-- Phoenix.Mediator.Serilog -->
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The API versioning scenario the duplicate-route check must not report. -->
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.0" />
  </ItemGroup>

  <!-- TestHost ships in lockstep with the shared framework, so each target framework gets its own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

</Project>
