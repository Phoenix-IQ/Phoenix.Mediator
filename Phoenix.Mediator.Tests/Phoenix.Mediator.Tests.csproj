<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the shipped TFMs: System.Text.Json behavior differs between them. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <!-- Real HTTP requests: the only authoritative way to test Minimal API parameter binding.
       Pinned per TFM because the package ships in lockstep with the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator\Phoenix.Mediator.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Validation\Phoenix.Mediator.Validation.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Sentry\Phoenix.Mediator.Sentry.csproj" />
    <!-- Referenced so the Serilog bootstrapping helpers are covered too; the review recorded them
         as completely untested because the test project did not reference them. -->
    <ProjectReference Include="..\Phoenix.Mediator.Serilog\Phoenix.Mediator.Serilog.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Serilog.Sentry\Phoenix.Mediator.Serilog.Sentry.csproj" />
  </ItemGroup>

</Project>
