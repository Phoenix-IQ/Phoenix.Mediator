<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFMs come from Directory.Build.props, shared with the shipped projects: System.Text.Json behavior differs
       between them. Package versions are in Directory.Packages.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Real HTTP requests: the only authoritative way to test Minimal API parameter binding.
         Versioned per TFM in Directory.Packages.props, because it ships in lockstep with the shared framework. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Asp.Versioning.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator\Phoenix.Mediator.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Validation\Phoenix.Mediator.Validation.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Sentry\Phoenix.Mediator.Sentry.csproj" />
    <!-- Referenced so the Serilog bootstrapping helpers are covered too; the review recorded them
         as completely untested because the test project did not reference them. -->
    <ProjectReference Include="..\Phoenix.Mediator.Serilog\Phoenix.Mediator.Serilog.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Serilog.Sentry\Phoenix.Mediator.Serilog.Sentry.csproj" />
  </ItemGroup>

</Project>
