<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (TFMs, package metadata, SourceLink, symbols, package validation) are in Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Phoenix.Mediator.Serilog.Sentry</PackageId>
    <Title>Phoenix.Mediator.Serilog.Sentry</Title>
    <Description>Sentry add-on for Phoenix.Mediator.Serilog: AddSentry() ASP.NET integration + WriteToSentry() Serilog sink.</Description>
    <PackageTags>mediator;serilog;sentry;logging;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry.AspNetCore" />
    <PackageReference Include="Sentry.Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator.Serilog\Phoenix.Mediator.Serilog.csproj" />
  </ItemGroup>

</Project>
