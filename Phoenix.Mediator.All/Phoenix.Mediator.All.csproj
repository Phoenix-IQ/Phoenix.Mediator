<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Phoenix.Mediator.All</PackageId>
    <Title>Phoenix.Mediator.All</Title>
    <Description>Convenience meta-package: pulls in Phoenix.Mediator and every opt-in companion (Validation, Sentry, Serilog, Serilog.Sentry). Install this when you want everything in one shot; install the individual packages instead when you want to pick and choose.</Description>
    <Authors>Phoenix-IQ</Authors>
    <Company>Phoenix-IQ</Company>
    <PackageTags>mediator;cqrs;aspnetcore;bundle;meta-package</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Phoenix-IQ/Phoenix.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Phoenix-IQ/Phoenix.Mediator.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Meta-package: no code, no assembly shipped, so no symbol package either
         (NuGet.org rejects empty .snupkg with "package does not contain any symbol files"). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);CS1591;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator\Phoenix.Mediator.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Validation\Phoenix.Mediator.Validation.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Sentry\Phoenix.Mediator.Sentry.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Serilog\Phoenix.Mediator.Serilog.csproj" />
    <ProjectReference Include="..\Phoenix.Mediator.Serilog.Sentry\Phoenix.Mediator.Serilog.Sentry.csproj" />
  </ItemGroup>

</Project>
