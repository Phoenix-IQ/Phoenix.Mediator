<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (TFMs, package metadata, SourceLink, symbols, package validation) are in Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Phoenix.Mediator.Serilog</PackageId>
    <Title>Phoenix.Mediator.Serilog</Title>
    <Description>Serilog bootstrapping and request log enrichment for Phoenix.Mediator apps. No third-party error-tracking dependency (add Phoenix.Mediator.Serilog.Sentry for Sentry).</Description>
    <PackageTags>mediator;serilog;logging;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator\Phoenix.Mediator.csproj" />
  </ItemGroup>

</Project>
