<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Phoenix.Mediator</PackageId>
    <Title>Phoenix.Mediator</Title>
    <Description>Lightweight mediator implementation with optional pipeline behaviors (validation + Sentry) and helpers for ASP.NET Core Minimal APIs.</Description>
    <Authors>Phoenix-IQ</Authors>
    <Company>Phoenix-IQ</Company>
    <PackageTags>mediator;cqrs;aspnetcore;minimal-api;fluentvalidation;sentry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Phoenix-IQ/Phoenix.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Phoenix-IQ/Phoenix.Mediator.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ship XML docs for documented members without failing on undocumented public APIs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic builds + SourceLink -->
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />

	</ItemGroup>
	<ItemGroup>
	  <!-- Core has no third-party runtime dependencies. Pipeline behaviors and logging
	       live in opt-in companion packages (Phoenix.Mediator.Validation / .Sentry / .Serilog). -->
	  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
	</ItemGroup>

  <ItemGroup>
    <!-- Ensure README is included in the NuGet package root -->
    <None Include="..\\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
