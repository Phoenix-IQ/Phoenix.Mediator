<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (TFMs, package metadata, SourceLink, symbols, package validation) are in Directory.Build.props. -->
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Phoenix.Mediator</PackageId>
    <Title>Phoenix.Mediator</Title>
    <Description>Lightweight mediator implementation with optional pipeline behaviors (validation + Sentry) and helpers for ASP.NET Core Minimal APIs.</Description>
    <PackageTags>mediator;cqrs;aspnetcore;minimal-api;fluentvalidation;sentry</PackageTags>
  </PropertyGroup>

  <!-- Core has no third-party runtime dependencies. Pipeline behaviors and logging
       live in opt-in companion packages (Phoenix.Mediator.Validation / .Sentry / .Serilog). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
