<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (TFMs, package metadata, SourceLink, symbols, package validation) are in Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Phoenix.Mediator.Validation</PackageId>
    <Title>Phoenix.Mediator.Validation</Title>
    <Description>FluentValidation pipeline behavior for Phoenix.Mediator.</Description>
    <PackageTags>mediator;cqrs;fluentvalidation;validation;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Mediator\Phoenix.Mediator.csproj" />
  </ItemGroup>

</Project>
