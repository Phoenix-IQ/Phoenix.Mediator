<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only, for this repository. Every dependency comes from there, and with Central Package Management
       NuGet warns (NU1507) when several sources could serve a package: a same-named package on another feed could be
       picked up instead. Feeds configured machine-wide (a company feed, a local test feed) don't apply here. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
